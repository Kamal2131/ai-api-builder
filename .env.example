# Server
PORT=8080
ROOT_PATH=

# LLM — OpenAI-compatible endpoint.
# Local dev with Ollama (default): http://localhost:11434/v1
# Inside docker-compose the app reaches Ollama at http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Model tag as pulled by Ollama, e.g. qwen2.5:3b or phi3:3.8b
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
