services:
  api:
    build: .
    ports:
      - "8000:8000"
    environment:
{% if database == "postgres" %}
      - DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app
{% elif database == "mysql" %}
      - DATABASE_URL=mysql+pymysql://root:root@db:3306/app
{% else %}
      - DATABASE_URL=sqlite:///./app.db
{% endif %}
{% if use_jwt %}
      - SECRET_KEY=change-me
{% endif %}
{% if database == "postgres" %}
    depends_on:
      - db
  db:
    image: postgres:16
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB=app
    ports:
      - "5432:5432"
{% elif database == "mysql" %}
    depends_on:
      - db
  db:
    image: mysql:8
    environment:
      - MYSQL_ROOT_PASSWORD=root
      - MYSQL_DATABASE=app
    ports:
      - "3306:3306"
{% endif %}
