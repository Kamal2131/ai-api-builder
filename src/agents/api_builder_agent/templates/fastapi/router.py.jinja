"""{{ entity.name }} CRUD routes for {{ project_name }}."""

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session

from app import crud, schemas
from app.deps import get_db
{% if use_jwt %}
from app.auth import get_current_user
{% endif %}

router = APIRouter(
    prefix="/{{ entity.plural }}",
    tags=["{{ entity.plural }}"],
{% if use_jwt %}
    dependencies=[Depends(get_current_user)],
{% endif %}
)


@router.post("", response_model=schemas.{{ entity.name }}Read, status_code=201)
def create(payload: schemas.{{ entity.name }}Create, db: Session = Depends(get_db)):
    return crud.create_{{ entity.snake }}(db, payload)


@router.get("", response_model=list[schemas.{{ entity.name }}Read])
def list_all(skip: int = 0, limit: int = 100, db: Session = Depends(get_db)):
    return crud.list_{{ entity.plural }}(db, skip=skip, limit=limit)


@router.get("/{item_id}", response_model=schemas.{{ entity.name }}Read)
def read(item_id: int, db: Session = Depends(get_db)):
    obj = crud.get_{{ entity.snake }}(db, item_id)
    if obj is None:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found")
    return obj


@router.put("/{item_id}", response_model=schemas.{{ entity.name }}Read)
def update(item_id: int, payload: schemas.{{ entity.name }}Update, db: Session = Depends(get_db)):
    obj = crud.update_{{ entity.snake }}(db, item_id, payload)
    if obj is None:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found")
    return obj


@router.delete("/{item_id}", status_code=204)
def delete(item_id: int, db: Session = Depends(get_db)):
    obj = crud.delete_{{ entity.snake }}(db, item_id)
    if obj is None:
        raise HTTPException(status_code=404, detail="{{ entity.name }} not found")
